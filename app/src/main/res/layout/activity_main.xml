<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Счётчик витков по магнитному полю"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/countText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="72sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/rawCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Сырые события: 0"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B: - | Δ: - | sig: - | thr: -"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ожидание данных"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <com.example.turncounter.GraphView
            android:id="@+id/graphView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Минимальный порог"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/thresholdSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/thresholdValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Порог: 3.0 мкТл"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Минимальный интервал между событиями"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/intervalSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2000"
            android:progress="120"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/intervalValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Интервал: 120 мс"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Событий на один виток"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/dividerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="0"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/dividerValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Событий на виток: 1"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/autoThresholdCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адаптивный порог"
            android:checked="false"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/soundCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Звук при витке"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/vibrationCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вибрация при витке"
            android:checked="false"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сброс"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/startStopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Старт" />

        </LinearLayout>

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Экспорт CSV"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Совет: закрепите магнит на вращающейся части катушки/шпули. Один оборот должен давать повторяющийся всплеск магнитного поля. Если один виток даёт два импульса, поставьте событий на виток = 2."
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
